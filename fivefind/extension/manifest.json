{
  "manifest_version": 3,
  "name": "FiveFind",
  "version": "1.2.0",
  "description": "Ouvre sur lefive.fr le créneau choisi dans FiveFind. Projet indépendant, non affilié à LE FIVE.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FiveFind",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.lefive.fr/*"
      ],
      "js": [
        "lefive.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://badyass.xyz/projects/fivefind/*",
        "http://localhost/projects/fivefind/*"
      ],
      "js": [
        "fivefind.js"
      ],
      "run_at": "document_start"
    }
  ]
}
